diff --git a/web/components/common/AndroidBackBridge.tsx b/web/components/common/AndroidBackBridge.tsx
new file mode 100644
index 0000000..9a3c8aa
--- /dev/null
+++ b/web/components/common/AndroidBackBridge.tsx
@@ -0,0 +1,98 @@
+"use client";
+
+import { useEffect } from "react";
+
+/**
+ * Back on Android (system button or edge gesture) should first close
+ * whatever is open on top of the page, exactly like Escape does on desktop.
+ *
+ * The Android shell calls ``window.__deeptutorBack()``, which resolves to
+ * ``true`` when the page consumed Back; otherwise the shell falls back to
+ * history / leaving the app. Every menu, popover and dialog here already
+ * closes on Escape, so this delivers an Escape to the open layer rather than
+ * teaching each one about Back separately.
+ */
+const OPEN_LAYER = [
+  "[role='dialog']",
+  "[role='alertdialog']",
+  "[aria-modal='true']",
+  "[role='menu']",
+  "[role='listbox']",
+].join(",");
+
+function openLayers(): Element[] {
+  return Array.from(document.querySelectorAll(OPEN_LAYER)).filter((element) => {
+    // Panels park off-screen (translated away, aria-hidden, inert) rather
+    // than unmount; only a layer the user can actually see and touch counts.
+    if (element.closest("[aria-hidden='true'], [inert]")) return false;
+    const rect = element.getBoundingClientRect();
+    if (rect.width === 0 || rect.height === 0) return false;
+    if (rect.right <= 0 || rect.bottom <= 0 || rect.left >= innerWidth || rect.top >= innerHeight) return false;
+    const style = getComputedStyle(element);
+    return (
+      style.visibility !== "hidden" &&
+      style.display !== "none" &&
+      style.pointerEvents !== "none" &&
+      Number(style.opacity) > 0
+    );
+  });
+}
+
+function nextFrame(): Promise<void> {
+  return new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve, 0)));
+}
+
+/** Gone, or on its way out: most layers fade or slide for ~200ms after closing. */
+async function leaving(layer: Element): Promise<boolean> {
+  const before = Number(getComputedStyle(layer).opacity);
+  for (let frame = 0; frame < 6; frame++) {
+    await nextFrame();
+    if (!layer.isConnected || !openLayers().includes(layer)) return true;
+    if (Number(getComputedStyle(layer).opacity) < before - 0.05) return true;
+  }
+  return false;
+}
+
+async function back(): Promise<boolean> {
+  const selection = window.getSelection();
+  if (selection && !selection.isCollapsed) {
+    selection.removeAllRanges();
+    return true;
+  }
+  const layers = openLayers();
+  if (layers.length === 0) {
+    // The overlay navigation drawer closes by tapping its scrim.
+    const scrim = document.querySelector<HTMLElement>("[data-android-back='close-drawer']");
+    if (!scrim) return false;
+    scrim.click();
+    return true;
+  }
+  const top = layers[layers.length - 1];
+  const active = document.activeElement;
+  // Escape where the layer listens: its focused control if it has one,
+  // otherwise the layer itself (bubbling reaches window/document handlers).
+  const target = active instanceof HTMLElement && top.contains(active) ? active : top;
+  const init: KeyboardEventInit = {
+    key: "Escape", code: "Escape", keyCode: 27, bubbles: true, cancelable: true, composed: true,
+  };
+  target.dispatchEvent(new KeyboardEvent("keydown", init));
+  target.dispatchEvent(new KeyboardEvent("keyup", init));
+  // If the layer ignored Escape, let Back navigate rather than trap the user.
+  return leaving(top);
+}
+
+declare global {
+  interface Window {
+    __deeptutorBack?: () => Promise<boolean>;
+  }
+}
+
+export default function AndroidBackBridge() {
+  useEffect(() => {
+    window.__deeptutorBack = back;
+    return () => {
+      if (window.__deeptutorBack === back) delete window.__deeptutorBack;
+    };
+  }, []);
+  return null;
+}
