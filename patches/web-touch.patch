diff --git a/web/hooks/useTouchPrimary.ts b/web/hooks/useTouchPrimary.ts
new file mode 100644
index 0000000..e8345bb
--- /dev/null
+++ b/web/hooks/useTouchPrimary.ts
@@ -0,0 +1,38 @@
+"use client";
+
+import { useSyncExternalStore } from "react";
+
+/* Whether the primary input is a finger rather than a mouse.
+ *
+ * Width (``useDevice``) and input are independent: a landscape tablet is as
+ * wide as a laptop, and a laptop window can be phone-narrow. Touch-specific
+ * behaviour keys off ``(hover: none) and (pointer: coarse)`` — the primary
+ * pointer — so a touchscreen laptop that also has a trackpad keeps the mouse
+ * behaviour it was designed for.
+ */
+const TOUCH_QUERY = "(hover: none) and (pointer: coarse)";
+
+let query: MediaQueryList | null = null;
+
+function media(): MediaQueryList | null {
+  if (typeof window === "undefined" || !window.matchMedia) return null;
+  query ??= window.matchMedia(TOUCH_QUERY);
+  return query;
+}
+
+function subscribe(onChange: () => void): () => void {
+  const list = media();
+  if (!list) return () => {};
+  list.addEventListener("change", onChange);
+  return () => list.removeEventListener("change", onChange);
+}
+
+/** Non-hook read for event handlers that should not re-render on change. */
+export function isTouchPrimary(): boolean {
+  return media()?.matches ?? false;
+}
+
+export function useTouchPrimary(): boolean {
+  // The server cannot know; render the mouse variant first, as before.
+  return useSyncExternalStore(subscribe, isTouchPrimary, () => false);
+}
diff --git a/web/hooks/useTouchSelectionSettled.ts b/web/hooks/useTouchSelectionSettled.ts
new file mode 100644
index 0000000..8cc5db6
--- /dev/null
+++ b/web/hooks/useTouchSelectionSettled.ts
@@ -0,0 +1,35 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+import { isTouchPrimary } from "@/hooks/useTouchPrimary";
+
+/**
+ * Run ``onSettled`` when a touch text selection stops changing.
+ *
+ * Mouse selections end with ``mouseup``, which is where these views read the
+ * selection. Touch selections (long press, then the system drag handles) fire
+ * no mouseup at all, so on touch-primary devices this listens to
+ * ``selectionchange`` instead and calls back once the handles rest.
+ * Does nothing on mouse-primary devices; their existing handlers stay in charge.
+ */
+export function useTouchSelectionSettled(onSettled: () => void, delay = 350): void {
+  const callback = useRef(onSettled);
+  useEffect(() => {
+    callback.current = onSettled;
+  }, [onSettled]);
+
+  useEffect(() => {
+    if (!isTouchPrimary()) return;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const onSelectionChange = () => {
+      clearTimeout(timer);
+      timer = setTimeout(() => callback.current(), delay);
+    };
+    document.addEventListener("selectionchange", onSelectionChange);
+    return () => {
+      clearTimeout(timer);
+      document.removeEventListener("selectionchange", onSelectionChange);
+    };
+  }, [delay]);
+}
