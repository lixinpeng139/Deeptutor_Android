new file mode 100644
index 0000000..3f631d4
--- /dev/null
+++ b/web/app/touch.css
@@ -0,0 +1,262 @@
+/*
+ * Touch adaptation layer.
+ *
+ * The UI was laid out for a mouse: 24–36px controls, actions that appear on
+ * hover, and drag handles a few pixels wide. Everything here is scoped to
+ * `(hover: none) and (pointer: coarse)` — a device whose *primary* input is a
+ * finger — so desktop and touchscreen laptops with a trackpad are untouched.
+ *
+ * Principles (Material / Apple HIG):
+ *   - every control has a hit area of at least 44×44 CSS px, grown with an
+ *     invisible ::after so the visual design and layout do not change;
+ *   - nothing is reachable only by hovering: hover-revealed actions are shown;
+ *   - hover styles never stick after a tap; :active gives immediate feedback;
+ *   - drag handles claim the gesture (`touch-action: none`) and are wider;
+ *   - text inputs use 16px so focusing them never zooms the page.
+ */
+@media (hover: none) and (pointer: coarse) {
+  :root {
+    --dt-touch-target: 44px;
+  }
+
+  html {
+    -webkit-tap-highlight-color: transparent;
+    /* No double-tap-to-zoom delay on taps. */
+    touch-action: manipulation;
+  }
+
+  /* ---- Hit areas ---------------------------------------------------- */
+
+  :is(button, [role="button"], [role="tab"], [role="menuitem"], [role="menuitemradio"],
+    [role="menuitemcheckbox"], [role="option"], [role="switch"], [role="checkbox"],
+    [role="radio"], summary, a[href], label:has(> input[type="checkbox"]),
+    label:has(> input[type="radio"])):not([data-touch-exempt]) {
+    position: relative;
+  }
+
+  /* A centred ::after at least 44×44, but never smaller than the element.
+     It sits under the element's own content, so it only catches taps that
+     would otherwise land just outside a small control. */
+  :is(button, [role="button"], [role="tab"], [role="switch"], [role="checkbox"],
+    [role="radio"], summary):not([data-touch-exempt]):not(:has(> input))::after {
+    content: "";
+    position: absolute;
+    left: 50%;
+    top: 50%;
+    width: max(100%, var(--dt-touch-target));
+    height: max(100%, var(--dt-touch-target));
+    transform: translate(-50%, -50%);
+    border-radius: inherit;
+    background: transparent;
+    pointer-events: auto;
+  }
+  /* The extension has to sit above the next block in the flow (a header
+     button's lower edge otherwise belongs to the content under it). Only
+     non-positioned flow boxes are outranked; overlays keep their z-index. */
+  :is(button, [role="button"], [role="tab"]):not([data-touch-exempt]):not([style*="z-index"]) {
+    z-index: 1;
+  }
+  /* The compact top bar's logo is the way home. */
+  a[href="/"]:has(> img) {
+    min-height: 40px;
+    padding-inline: 4px;
+  }
+  /* Square 32px icon buttons (page bars, calendar, panels) become 40px. */
+  button:is(.h-8.w-8, .size-8) {
+    min-width: 40px;
+    min-height: 40px;
+  }
+
+  /* Menu, list and navigation rows: grow the row itself, they have room. */
+  :is([role="menuitem"], [role="menuitemradio"], [role="menuitemcheckbox"], [role="option"]) {
+    min-height: var(--dt-touch-target);
+  }
+  nav a[href], aside a[href], [role="navigation"] a[href], [role="tablist"] > * {
+    min-height: 40px;
+  }
+  /* Conversation and record rows in the sidebar (div role=button rows). */
+  :is(nav, aside, [role="navigation"]) div[role="button"] {
+    min-height: 40px;
+  }
+
+  /* Inline links in prose keep their line height; their padding grows instead. */
+  :is(p, li, td, blockquote) > a[href] {
+    padding-block: 4px;
+    margin-block: -4px;
+  }
+
+  /* Component stylesheets (calendar.css …) load per route, after this file;
+     `:root` lifts these overrides above their equal-specificity rules. */
+  /* Icon rows packed 2px apart: grown hit areas would overlap and a tap
+     between two icons would hit the wrong one. Give them room instead.
+     Buttons are often wrapped (tooltips render an inline-flex span). */
+  :is(.gap-0, .gap-px, .gap-0\.5, .gap-1):has(> :is(button, [role="button"], a[href]),
+    > * > :is(button, [role="button"])) {
+    column-gap: 8px;
+  }
+  :root .dt-tray-bar, :root .dt-navigation-actions, :root .dt-cal-toolbar, :root .dt-cal-step {
+    column-gap: 8px;
+  }
+  /* Month cells: the date and the footprint dot share a 30px header in a
+     cell that can be 50px wide. The date keeps its width (it is the bigger
+     target); the header grows taller and the dot takes what is left. */
+  :root .dt-cal-cell-head {
+    height: 40px;
+    padding: 0 3px;
+    min-width: 0;
+    overflow: hidden;
+  }
+  :root .dt-cal-cell-date {
+    height: 32px;
+    min-width: 32px;
+    padding-inline: 4px;
+    flex-shrink: 0;
+    white-space: nowrap;
+  }
+  :root .dt-cal-footprint {
+    height: 32px;
+    min-width: 10px;
+    flex: 0 1 28px;
+  }
+  /* Their neighbours are other days: never reach into the next cell (the
+     header clips them). The footprint dot, later in the row, wins where the
+     two overlap. */
+  :root .dt-cal-cell-date::after {
+    width: max(100%, 40px) !important;
+    height: 40px !important;
+  }
+  :root .dt-cal-footprint::after {
+    width: 100% !important;
+    height: 40px !important;
+  }
+  /* The sidebar's mini month: seven days to a 248px row, 2px apart. Widen
+     the rail a little and make each day a taller cell that tiles, rather
+     than extending into its neighbours. */
+  :root .dt-cal-rail {
+    flex-basis: 280px;
+  }
+  :root .dt-cal-mini-row {
+    gap: 0;
+  }
+  :root .dt-cal-mini-day {
+    height: 36px;
+  }
+  :root .dt-cal-mini-day::after {
+    width: 100% !important;
+    height: 100% !important;
+  }
+  :root .dt-tray-button {
+    height: 36px;
+    padding-inline: 10px;
+  }
+  :root .dt-nav-icon {
+    min-width: 36px;
+    min-height: 36px;
+  }
+
+  /* Native checkboxes and radios are 13px in WebView. */
+  input:is([type="checkbox"], [type="radio"]) {
+    min-width: 22px;
+    min-height: 22px;
+  }
+  input[type="range"] {
+    min-height: var(--dt-touch-target);
+  }
+
+  /* ---- Typing ------------------------------------------------------- */
+
+  /* Anything smaller than 16px makes the WebView zoom into the field. */
+  :is(input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]),
+    textarea, select, [contenteditable="true"]) {
+    font-size: max(16px, 1em);
+  }
+
+  /* ---- Hover-only content ------------------------------------------- */
+
+  /* Tailwind group-hover reveals (`opacity-0 group-hover:opacity-100`). */
+  .group .opacity-0[class*="group-hover:opacity-100"],
+  .group .opacity-0[class*="group-hover/"][class*="opacity-100"],
+  .opacity-0[class*="sm:group-hover:opacity-100"] {
+    opacity: 1 !important;
+  }
+  .group [class*="group-hover:translate-"],
+  .group [class*="group-hover:translate-y-0"] {
+    transform: none !important;
+  }
+
+  /* The app's own CSS reveals. */
+  :root .dt-account-tabs.is-tucked [role="tab"],
+  :root .dt-lead-token .dt-lead-icon > svg:last-child,
+  :root .dt-starter-row .dt-starter-enter,
+  :root .dt-crumb .dt-crumb-caret {
+    opacity: 1;
+  }
+  /* The sidebar's account tabs fold into one overlapping stack that fans out
+     on hover. Without hover the second tab stays half-covered: keep it open. */
+  :root .dt-account-tabs.is-tucked [role="tab"] {
+    padding: 0 clamp(5px, (100cqi - 180px) / 10, 10px);
+  }
+  :root .dt-account-tabs.is-tucked > :last-child [role="tab"] {
+    margin-left: 0;
+  }
+  :root .dt-account-tabs.is-tucked > :last-child [role="tab"] > svg {
+    transform: none;
+  }
+  :root .dt-category-bar [role="tablist"], :root .dt-account-tabs {
+    column-gap: 2px;
+  }
+  :root .dt-sidebar-header {
+    column-gap: 6px;
+  }
+
+  /* ---- Feedback ----------------------------------------------------- */
+
+  :is(button, [role="button"], [role="menuitem"], [role="option"], [role="tab"], a[href]):not(:disabled):active {
+    filter: brightness(0.94);
+  }
+  .dark :is(button, [role="button"], [role="menuitem"], [role="option"], [role="tab"], a[href]):not(:disabled):active {
+    filter: brightness(1.18);
+  }
+
+  /* ---- Drag handles ------------------------------------------------- */
+
+  /* Panel resizers and grab handles: the browser must not turn the drag
+     into a scroll, and a finger needs more than the 4–8px a cursor gets. */
+  :is(.cursor-col-resize, .cursor-ew-resize, .cursor-row-resize, .cursor-ns-resize,
+    .cursor-grab, [role="separator"][aria-orientation]) {
+    touch-action: none;
+  }
+  /* Handles sit on panel edges, right next to that panel's buttons: grow
+     them a little but stack them under those buttons (which get z-index 1
+     above), so a tap near an edge button still hits the button. */
+  :is(.cursor-col-resize, .cursor-ew-resize, [role="separator"][aria-orientation="vertical"]) {
+    z-index: 0 !important;
+  }
+  :is(.cursor-col-resize, .cursor-ew-resize, [role="separator"][aria-orientation="vertical"])::after {
+    content: "";
+    position: absolute;
+    inset: 0 -6px;
+    z-index: -1;
+  }
+  :is(.cursor-row-resize, .cursor-ns-resize, [role="separator"][aria-orientation="horizontal"])::after {
+    content: "";
+    position: absolute;
+    inset: -6px 0;
+    z-index: -1;
+  }
+
+  /* Native HTML drag sources (calendar, board, file list) start on long press. */
+  [draggable="true"] {
+    -webkit-user-drag: element;
+    -webkit-touch-callout: none;
+  }
+
+  /* ---- Scrolling ---------------------------------------------------- */
+
+  /* Thin scrollbars are pointless under a finger; keep momentum and stop
+     inner scrollers from dragging the whole page when they hit an end. */
+  .overflow-y-auto, .overflow-auto, .overflow-x-auto {
+    -webkit-overflow-scrolling: touch;
+    overscroll-behavior: contain;
+  }
+}
